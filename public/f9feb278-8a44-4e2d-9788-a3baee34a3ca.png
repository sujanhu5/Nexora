<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 140" width="540" height="140" fill="none">
  <defs>
    <!-- Chrome Metallic Gradient for IDEATHON -->
    <linearGradient id="chromeMetallic" x1="0" y1="30" x2="0" y2="84" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="28%" stop-color="#f8fafc" />
      <stop offset="46%" stop-color="#cbd5e1" />
      <stop offset="50%" stop-color="#ffffff" />
      <stop offset="68%" stop-color="#7dd3fc" />
      <stop offset="85%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>

    <!-- Wordmark Chrome Gradient for NEXORA -->
    <linearGradient id="nexoraChrome" x1="0" y1="72" x2="0" y2="90" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="45%" stop-color="#f1f5f9" />
      <stop offset="55%" stop-color="#ffffff" />
      <stop offset="80%" stop-color="#93c5fd" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>

    <!-- Luminous Cyan Orbital Ring Gradient -->
    <linearGradient id="ringGrad" x1="30" y1="35" x2="185" y2="105" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.8" />
      <stop offset="30%" stop-color="#ffffff" stop-opacity="1" />
      <stop offset="50%" stop-color="#bae6fd" stop-opacity="0.95" />
      <stop offset="80%" stop-color="#38bdf8" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.6" />
    </linearGradient>

    <!-- Wireframe Sphere Gradient -->
    <linearGradient id="wireframeGrad" x1="60" y1="25" x2="160" y2="115" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9" />
      <stop offset="30%" stop-color="#bae6fd" stop-opacity="0.8" />
      <stop offset="70%" stop-color="#38bdf8" stop-opacity="0.65" />
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.4" />
    </linearGradient>

    <!-- Vertical Line Gradient -->
    <linearGradient id="vertLineGrad" x1="0" y1="24" x2="0" y2="116" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0" />
      <stop offset="25%" stop-color="#38bdf8" stop-opacity="0.6" />
      <stop offset="50%" stop-color="#ffffff" stop-opacity="1" />
      <stop offset="75%" stop-color="#38bdf8" stop-opacity="0.6" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
    </linearGradient>

    <!-- Horizontal Subtitle Lines -->
    <linearGradient id="horizLineLeft" x1="240" y1="0" x2="310" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0" />
      <stop offset="60%" stop-color="#38bdf8" stop-opacity="0.7" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.95" />
    </linearGradient>
    <linearGradient id="horizLineRight" x1="395" y1="0" x2="465" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
      <stop offset="40%" stop-color="#38bdf8" stop-opacity="0.7" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
    </linearGradient>

    <!-- Glow Filters -->
    <filter id="cyanGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <filter id="intenseGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="5" result="blur1" />
      <feGaussianBlur stdDeviation="1.5" result="blur2" />
      <feMerge>
        <feMergeNode in="blur1" />
        <feMergeNode in="blur2" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Ambient Cosmic Blue Curve Trails at Bottom -->
  <path d="M -20 140 Q 230 126 560 140" stroke="#0284c7" stroke-width="4.5" opacity="0.45" filter="url(#cyanGlow)" />
  <path d="M 0 138 Q 260 124 540 138" stroke="#38bdf8" stroke-width="1.8" opacity="0.8" filter="url(#cyanGlow)" />
  <path d="M -40 126 Q 140 133 390 118 T 570 100" stroke="#0ea5e9" stroke-width="1" opacity="0.35" />
  <path d="M -20 102 Q 130 119 330 125 T 560 120" stroke="#38bdf8" stroke-width="0.8" opacity="0.3" />

  <!-- ==================== LEFT: CELESTIAL GLOBE ==================== -->
  <g transform="translate(108, 70)">
    <!-- Radial Ambient Blue Glow Behind Planet -->
    <circle cx="0" cy="0" r="62" fill="#0284c7" opacity="0.2" filter="url(#intenseGlow)" />
    <circle cx="0" cy="0" r="48" fill="#000000" />

    <!-- Orbital Ring - BACK HALF (tilted -21 degrees) -->
    <g transform="rotate(-21)">
      <path d="M -76 0 A 76 19 0 0 1 76 0" stroke="url(#ringGrad)" stroke-width="2.8" opacity="0.65" filter="url(#cyanGlow)" />
      <path d="M -76 0 A 76 19 0 0 1 76 0" stroke="#bae6fd" stroke-width="1.2" opacity="0.8" />
    </g>

    <!-- Sphere Outer Rim Glow & Base Circle -->
    <circle cx="0" cy="0" r="47.5" stroke="url(#wireframeGrad)" stroke-width="2" filter="url(#cyanGlow)" />
    <circle cx="0" cy="0" r="47.5" stroke="#ffffff" stroke-width="0.9" opacity="0.85" />

    <!-- Wireframe Latitude Parallels -->
    <g stroke="url(#wireframeGrad)" stroke-width="0.9" opacity="0.75">
      <ellipse cx="0" cy="-26" rx="39" ry="13" fill="none" />
      <ellipse cx="0" cy="-9" rx="46" ry="16" fill="none" />
      <ellipse cx="0" cy="9" rx="46" ry="16" fill="none" />
      <ellipse cx="0" cy="26" rx="39" ry="13" fill="none" />
    </g>

    <!-- Wireframe Longitude Meridians -->
    <g stroke="url(#wireframeGrad)" stroke-width="0.9" opacity="0.75">
      <ellipse cx="0" cy="0" rx="15" ry="47" fill="none" />
      <ellipse cx="0" cy="0" rx="31" ry="47" fill="none" />
      <line x1="0" y1="-47" x2="0" y2="47" stroke-width="1.1" />
    </g>

    <!-- Constellation Diagonal Cross Lines -->
    <g stroke="#7dd3fc" stroke-width="0.75" opacity="0.65">
      <path d="M -33 -22 L 18 -35 L 38 -9 L 14 14 L -23 5 Z" fill="none" />
      <path d="M -44 0 L -18 -27 L 23 -23 L 32 14 L -9 29 Z" fill="none" />
      <path d="M -27 -32 L 32 23" />
      <path d="M 27 -32 L -32 23" />
      <path d="M -40 16 L 40 -16" />
      <path d="M -18 36 L 32 -14" />
    </g>

    <!-- Sparkling Vertex Nodes / Stars -->
    <g fill="#ffffff">
      <circle cx="0" cy="-47" r="1.8" filter="url(#cyanGlow)" />
      <circle cx="0" cy="47" r="1.8" filter="url(#cyanGlow)" />
      <circle cx="-47" cy="0" r="1.8" filter="url(#cyanGlow)" />
      <circle cx="47" cy="0" r="1.8" filter="url(#cyanGlow)" />
      <circle cx="-33" cy="-22" r="1.6" />
      <circle cx="18" cy="-35" r="2" filter="url(#cyanGlow)" />
      <circle cx="38" cy="-9" r="1.8" />
      <circle cx="-23" cy="-14" r="1.5" />
      <circle cx="26" cy="16" r="1.6" />
      <circle cx="-32" cy="20" r="1.6" />
      <circle cx="14" cy="-14" r="2.2" filter="url(#cyanGlow)" />
      <circle cx="-15" cy="11" r="1.5" />
      <circle cx="33" cy="-26" r="1.6" />
      <circle cx="-38" cy="-16" r="1.6" />
    </g>

    <!-- NEXORA Pill Ribbon Backing & Typography Inside Lower Half of Globe -->
    <g transform="translate(0, 14)">
      <!-- Dark backdrop pill for high text contrast -->
      <rect x="-40" y="-10" width="80" height="20" rx="10" fill="#010613" fill-opacity="0.9" stroke="#38bdf8" stroke-width="1.1" stroke-opacity="0.65" filter="url(#cyanGlow)" />
      
      <!-- High-contrast inner stroke -->
      <rect x="-39" y="-9" width="78" height="18" rx="9" fill="none" stroke="#bae6fd" stroke-width="0.75" stroke-opacity="0.8" />

      <!-- Stylized NEXORA Wordmark -->
      <text
        x="0"
        y="5"
        text-anchor="middle"
        font-family="'Syne', 'Outfit', sans-serif"
        font-weight="900"
        font-size="14.5"
        letter-spacing="3.2"
        fill="url(#nexoraChrome)"
        stroke="#010613"
        stroke-width="1"
        style="paint-order: stroke fill;"
      >NEXORA</text>
    </g>

    <!-- Orbital Ring - FRONT HALF (tilted -21 degrees) -->
    <g transform="rotate(-21)">
      <!-- Outer wide glow path -->
      <path d="M 76 0 A 76 19 0 0 1 -76 0" stroke="url(#ringGrad)" stroke-width="4.2" opacity="0.95" filter="url(#intenseGlow)" />
      <!-- Sharp core luminous line -->
      <path d="M 76 0 A 76 19 0 0 1 -76 0" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" />
      <!-- Left/Right endpoints sparkling stars -->
      <circle cx="-76" cy="0" r="2.6" fill="#ffffff" filter="url(#intenseGlow)" />
      <circle cx="76" cy="0" r="2.6" fill="#ffffff" filter="url(#intenseGlow)" />
    </g>
  </g>

  <!-- ==================== CENTER: VERTICAL DIVIDER & STAR FLARE ==================== -->
  <g transform="translate(196, 0)">
    <!-- Vertical Divider Line -->
    <line x1="0" y1="24" x2="0" y2="116" stroke="url(#vertLineGrad)" stroke-width="1.6" />
    <line x1="0" y1="40" x2="0" y2="100" stroke="#ffffff" stroke-width="0.75" opacity="0.85" />

    <!-- Brilliant 4-Point Star Lens Flare in Center (y=70) -->
    <g transform="translate(0, 70)">
      <!-- Radial Halo -->
      <circle cx="0" cy="0" r="9" fill="#38bdf8" opacity="0.5" filter="url(#intenseGlow)" />
      <circle cx="0" cy="0" r="3.2" fill="#ffffff" filter="url(#cyanGlow)" />
      <circle cx="0" cy="0" r="1.6" fill="#ffffff" />

      <!-- Horizontal lens flare spikes -->
      <path d="M -16 0 Q 0 -1 16 0 Q 0 1 -16 0 Z" fill="#ffffff" filter="url(#cyanGlow)" />
      <line x1="-25" y1="0" x2="25" y2="0" stroke="#38bdf8" stroke-width="1.1" opacity="0.8" />

      <!-- Vertical lens flare spikes -->
      <path d="M 0 -16 Q -1 0 0 16 Q 1 0 0 -16 Z" fill="#ffffff" filter="url(#cyanGlow)" />
      <line x1="0" y1="-25" x2="0" y2="25" stroke="#38bdf8" stroke-width="1.1" opacity="0.8" />
    </g>
  </g>

  <!-- ==================== RIGHT: IDEATHON 2026 ==================== -->
  <g transform="translate(216, 0)">
    <!-- Deep text drop-shadow -->
    <text
      x="0"
      y="76"
      font-family="'Syne', 'Outfit', sans-serif"
      font-weight="900"
      font-size="48"
      letter-spacing="4.5"
      fill="#000000"
      stroke="#0284c7"
      stroke-width="4.5"
      opacity="0.8"
      filter="url(#intenseGlow)"
    >IDEATHON</text>

    <!-- Main Chrome Metallic Title IDEATHON -->
    <text
      x="0"
      y="76"
      font-family="'Syne', 'Outfit', sans-serif"
      font-weight="900"
      font-size="48"
      letter-spacing="4.5"
      fill="url(#chromeMetallic)"
      stroke="#01040a"
      stroke-width="1.8"
      style="paint-order: stroke fill;"
    >IDEATHON</text>

    <!-- Subtitle: Left Line, 2026, Right Line -->
    <g transform="translate(0, 102)">
      <!-- Left Horizontal Rule Accent -->
      <line x1="10" y1="-5" x2="94" y2="-5" stroke="url(#horizLineLeft)" stroke-width="1.6" />
      
      <!-- 2 0 2 6 Spaced Typography -->
      <text
        x="162"
        y="0"
        text-anchor="middle"
        font-family="'Outfit', 'Space Grotesk', sans-serif"
        font-weight="700"
        font-size="19"
        letter-spacing="8"
        fill="#f8fafc"
        stroke="#0284c7"
        stroke-width="0.7"
        filter="url(#cyanGlow)"
      >2026</text>

      <!-- Right Horizontal Rule Accent -->
      <line x1="230" y1="-5" x2="314" y2="-5" stroke="url(#horizLineRight)" stroke-width="1.6" />
    </g>
  </g>
</svg>
